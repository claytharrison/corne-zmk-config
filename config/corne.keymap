/*
 * Corne Keymap for ZMK
 * 
 * Features:
 * - Homerow mods (Ctrl/Alt/Shift/GUI on ASDF JKL;)
 * - LOWER (left thumb): numbers, BT control, arrows
 * - RAISE (right thumb): numbers, symbols, volume
 * - MOUSE (both thumbs): mouse movement, clicks, scroll
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * LAYER 0: BASE with Homerow Mods
         */
        layer0: base {
            display-name = "Base";
            bindings = <
                &kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T     &kp Y     &kp U     &kp I     &kp O   &kp P   &kp BSPC
                &hm LC A  &hm LA S  &hm LS D  &hm LG F  &kp G   &kp H     &kp J     &kp K     &kp L     &hm RC SEMI &hm RA QUOTE &hm RS SLASH
                &kp ESC   &kp Z   &kp X   &kp C   &kp V   &kp B     &kp N     &kp M     &kp COMMA &kp DOT &kp SLASH &kp RSFT
                          &kp LGUI  &mo LOWER &kp SPACE           &kp RET   &mo RAISE &kp RALT
            >;
        };

        /*
         * LAYER 1: LOWER (left thumb hold)
         */
        lower: lower {
            display-name = "Lower";
            bindings = <
                &kp TAB    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
                &kp ESC    &trans   &trans   &trans   &trans   &trans     &trans    &trans    &trans    &trans    &trans    &trans
                           &kp LGUI  &trans   &kp SPACE           &kp RET   &mo MOUSE &kp RALT
            >;
        };

        /*
         * LAYER 2: RAISE (right thumb hold)
         */
        raise: raise {
            display-name = "Raise";
            bindings = <
                &kp TAB    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &trans     &trans   &trans   &trans   &trans   &trans     &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
                &trans     &trans   &trans   &trans   &trans   &trans     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                           &kp C_VOL_DN &trans &kp SPACE           &kp RET   &trans    &kp C_VOL_UP
            >;
        };

        /*
         * LAYER 3: MOUSE (LOWER + RAISE together)
         */
        mouse: mouse {
            display-name = "Mouse";
            bindings = <
                &kp TAB    &mkp LCLK &mkp RCLK &mkp MCLK &kp N4   &kp N5     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &trans     &trans    &trans    &trans    &trans   &trans     &mmv LEFT &mmv DOWN &mmv UP   &mmv RIGHT &trans    &trans
                &trans     &trans    &trans    &trans    &trans   &trans     &msc UP   &msc DOWN
                           &kp LGUI   &trans    &kp SPACE           &kp RET    &trans    &kp RALT
            >;
        };
    };
};
