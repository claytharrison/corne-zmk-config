/*
 * Corne Keymap for ZMK
 * A simple starting point - customize as needed
 */

#include <behaviors.dtsi>
#include <corne.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer0: base {
            display-name = "Base";
            bindings = <
                /* Left hand - numbers row */
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5
                &kp TAB &kp Q &kp W &kp E &kp R &kp T
                &kp CAPSLOCK &kp A &kp S &kp D &kp F &kp G
                &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B
                &kp LCTRL &kp LALT &kp LGUI LOWER &kp SPACE &kp BSPC

                /* Right hand - numbers row */
                &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
                &kp Y &kp U &kp I &kp O &kp P &kp LBKT
                &kp H &kp J &kp K &kp L &kp SEMI &kp QUOTE
                &kp N &kp M &kp COMMA &kp DOT &kp SLASH &kp RSFT
                &kp RET &kp ALTGR RAISE &kp BSPC &kp SPACE &kp RCTRL

                /* Thumb clusters */
                &kp ESC &kp ENT
                &kp ENT &kp ESC
            >;
        };

        lower: lower {
            display-name = "Lower";
            bindings = <
                /* Left hand */
                &kp TILDE &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PERCENT
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6
                &kp &none &kp LEFT &kp UP &kp DOWN &kp RIGHT
                &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp &none &kp &none &trans &kp &none &kp DEL

                /* Right hand */
                &kp CIRC &kp AMPR &kp ASTR &kp LPAR &kp RPAR &kp EQL
                &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &kp PG_UP &kp HOME &kp PG_DN &kp END &kp &none &kp &none
                &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &trans &kp &none &kp &none &kp &none &kp &none

                /* Thumb clusters */
                &kp &none &kp &none
                &kp &none &kp &none
            >;
        };

        raise: raise {
            display-name = "Raise";
            bindings = <
                /* Left hand */
                &kp TILDE &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PERCENT
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6
                &kp &none &kp LEFT &kp UP &kp DOWN &kp RIGHT
                &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp &none &kp &none &trans &kp &none &kp DEL

                /* Right hand */
                &kp CIRC &kp AMPR &kp ASTR &kp LPAR &kp RPAR &kp EQL
                &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &kp PG_UP &kp HOME &kp PG_DN &kp END &kp &none &kp &none
                &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &trans &kp &none &kp &none &kp &none &kp &none

                /* Thumb clusters */
                &kp &none &kp &none
                &kp &none &kp &none
            >;
        };
    };
};
