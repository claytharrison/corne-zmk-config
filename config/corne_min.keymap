/*
 * Corne Keymap for ZMK
 * 
 * Features:
 * - Homerow mods (Ctrl/Alt/Shift/GUI on ASDF JKL;)
 * - LOWER (left thumb): numbers, BT control, arrows
 * - RAISE (right thumb): numbers, symbols, volume
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Mouse movement behavior */
        mmv: mouse_move {
            compatible = "zmk,behavior-mouse-move";
            #binding-cells = <2>;
        };

        /* Mouse scroll behavior */
        msc: mouse_scroll {
            compatible = "zmk,behavior-mouse-scroll";
            #binding-cells = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* BASE LAYER with Homerow Mods */
        layer0: base {
            display-name = "Base";
            bindings = <
                &kp ESC    &kp Q    &kp W    &kp E    &kp R    &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                &kp LCTRL  &hm LCTRL A &hm LALT S &hm LSHFT D &hm LGUI F &kp G  &kp H  &hm RGUI J &hm RSHFT K &hm RALT L &hm RCTRL SEMI &kp SQT
                &kp TAB    &kp Z    &kp X    &kp C    &kp V    &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp SLASH &kp RSFT
                           &kp LGUI &mo 1    &kp SPACE                   &kp RET   &mo 2     &kp RALT
            >;
        };

        /* LOWER LAYER - Numbers, BT, Arrows */
        lower: lower {
            display-name = "Lower";
            bindings = <
                &kp ESC    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
                &kp TAB    &trans   &trans   &trans   &trans   &trans     &trans    &trans    &trans    &trans    &trans    &trans
                           &kp LGUI &trans   &kp SPACE                   &kp RET   &mo 3     &kp RALT
            >;
        };

        /* RAISE LAYER - Numbers, Symbols, Volume */
        raise: raise {
            display-name = "Raise";
            bindings = <
                &kp ESC    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &trans     &trans   &trans   &trans   &trans   &trans     &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
                &trans     &trans   &trans   &trans   &trans   &trans     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                           &kp C_VOL_DN &trans &kp SPACE                   &kp RET   &trans    &kp C_VOL_UP
            >;
        };

        /* MOUSE LAYER - Both thumbs together */
        mouse: mouse {
            display-name = "Mouse";
            bindings = <
                &kp ESC    &mkp LCLK &mkp RCLK &mkp MCLK &kp N4  &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &trans     &trans   &trans   &trans   &trans   &trans     &mmv <(-400)> <0> &mmv <0> <(400)> &mmv <0> <(-400)> &mmv <(400)> <0> &trans    &trans
                &bootloader &trans  &trans   &trans   &trans   &trans     &msc <(1)> &msc <(-1)> &trans    &trans    &trans    &bootloader
                           &kp LGUI &trans   &kp SPACE                   &kp RET   &trans    &kp RALT
            >;
        };
    };
};
